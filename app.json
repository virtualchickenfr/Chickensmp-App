{
  "expo": {
    "name": "ChickenSMP",
    "slug": "chickensmp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141414",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "android": {
      "package": "net.chickensmp.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141414"
      }
    },
    "ios": {
      "bundleIdentifier": "net.chickensmp.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "ChickenSMP",
      "shortName": "ChickenSMP",
      "themeColor": "#141414",
      "backgroundColor": "#141414",
      "favicon": "./assets/icon.png"
    },
    "runtimeVersion": "2",
    "updates": {
      "url": "https://store.chickensmp.net/api/ota",
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ServerStatus",
              "label": "ChickenSMP Server",
              "description": "Serverstatus und Spieler online",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "220dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMinutes": 30
            }
          ]
        }
      ]
    ]
  }
}