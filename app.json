{
  "expo": {
    "name": "ChickenSMP",
    "slug": "chickensmp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141414",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#141414"
    },
    "android": {
      "package": "net.chickensmp.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141414"
      }
    },
    "ios": {
      "bundleIdentifier": "net.chickensmp.app",
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "ChickenSMP",
      "shortName": "ChickenSMP",
      "themeColor": "#141414",
      "backgroundColor": "#141414",
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "baseUrl": "/Chickensmp-App"
    }
  }
}